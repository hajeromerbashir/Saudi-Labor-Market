## _PrivateSector Value
Returns overall private-sector employment metrics by demographic group.
_PrivateSector Value = 
VAR SelectedGroup = SELECTEDVALUE('Gender & Nationality'[Combined], "الإجمالي - الكل")
RETURN
SWITCH(
    SelectedGroup,
    "سعوديون - ذكور",        MAX('قطاع خاص'[سعوديون - ذكور]),
    "سعوديون - إناث",        MAX('قطاع خاص'[سعوديون - إناث]),
    "سعوديون - إجمالي",      MAX('قطاع خاص'[سعوديون - إجمالي]),
    "غير سعوديين - ذكور",    MAX('قطاع خاص'[غير سعوديين -  ذكور]),
    "غير سعوديين - إناث",    MAX('قطاع خاص'[غير سعوديين -  إناث]),
    "غير سعوديين - إجمالي",  MAX('قطاع خاص'[غير سعوديين -  إجمالي]),
    MAX('قطاع خاص'[إجمالي  - الكل])
)

