## _SA Private Sector Value & _SA Public Sector Value
Track Saudi-only share across private vs. public sectors for Vision 2030 structural shift analysis.

_SA Private Sector Value = 
VAR SelectedGroup = SELECTEDVALUE('Gender & Nationality'[Combined], "سعوديون - إجمالي")
RETURN
SWITCH(
    TRUE(),
    SelectedGroup = "سعوديون - ذكور", MAX('قطاع خاص'[سعوديون - ذكور]),
    SelectedGroup = "سعوديون - إناث", MAX('قطاع خاص'[سعوديون - إناث]),
    MAX('قطاع خاص'[سعوديون - إجمالي])
)

_SA Public Sector Value = 
VAR SelectedGroup = SELECTEDVALUE('Gender & Nationality'[Combined], "سعوديون - إجمالي")
RETURN
SWITCH(
    TRUE(),
    SelectedGroup = "سعوديون - ذكور", MAX('قطاع عام'[سعوديون - ذكور]),
    SelectedGroup = "سعوديون - إناث", MAX('قطاع عام'[سعوديون - إناث]),
    MAX('قطاع عام'[سعوديون - إجمالي])
)

## _Saudization Value
Returns the Saudization percentage in targeted economic sectors.
_Saudization Value = 
VAR SelectedGroup = SELECTEDVALUE('Gender & Nationality'[Combined], "سعوديون - إجمالي")
RETURN
SWITCH(
    TRUE(),
    SelectedGroup = "سعوديون - ذكور", MAX('القطاعات'[سعوديون - ذكور %]),
    SelectedGroup = "سعوديون - إناث", MAX('القطاعات'[سعوديون - إناث %]),
    MAX('القطاعات'[سعوديون - إجمالي %])
)






















