// B. KPI Conditional Formatting (Hex Color Measures)
Applies domain-aware semantic coloring (#3B6D11 Positive Green, #C62828 Alert Red, #8A94A0 Neutral Gray) to YoY KPI indicators.

Standard Positive-Growth Pattern (also used for Color - Participation and Color - Private Sector):

#1 Color - GOSI =
VAR Change = [_YOY num GOSI]
RETURN
SWITCH(
    TRUE(),
    Change > 0, "#3B6D11",   -- Employment growth = positive
    Change < 0, "#C62828",
    "#8A94A0"
)


** Inverse Metric Pattern (a drop in unemployment is treated as a positive achievement):
#2 Color - SA Unemployment =
VAR Change = [_YOY SA Unemployment]
RETURN
SWITCH(
    TRUE(),
    Change < 0, "#3B6D11",   -- Lower unemployment = achievement
    Change > 0, "#C62828",
    "#8A94A0"
)


#3 Color - Participation = 
VAR Change = [_YOY num Participation]
RETURN
SWITCH( TRUE(),
    Change > 0,"#3B6D11" ,
    Change < 0, "#C62828",
    "#8A94A0"
)


#4 Color - Private Sector = 
VAR Change = [_YOY PrivetSector]
RETURN
SWITCH( TRUE(),
    Change > 0, "#3B6D11",
    Change < 0, "#C62828",
    "#8A94A0"
)



// C. First & Last Data Labels on Trend Lines (5 Measures)

#1 Label - First & Last (SA Female PArticipation) =
VAR CurrentVal  = [SA Female Participation (National)]
VAR CurrentDate = MAX(Calender[Quarter Start])
VAR DataQuarters =
    FILTER(
        ALLSELECTED(Calender[Quarter Lable], Calender[Quarter Start]),
        NOT ISBLANK([SA Female Participation (National)])
    )
VAR MinDate = MINX(DataQuarters, Calender[Quarter Start])
VAR MaxDate = MAXX(DataQuarters, Calender[Quarter Start])
RETURN
IF(
    NOT ISBLANK(CurrentVal) &&
    (CurrentDate = MinDate || CurrentDate = MaxDate),
    CurrentVal,
    BLANK()
)


